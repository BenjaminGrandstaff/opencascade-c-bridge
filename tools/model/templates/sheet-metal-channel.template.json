{
  "schema": "occb-model-template-v1",
  "id": "sheet-metal-channel",
  "version": 1,
  "title": "Sheet-metal U-channel and flat blank",
  "summary": "A U-shaped channel bent from one sheet, with its flat blank at the given K factor.",
  "use_when": "Brackets, covers and rails folded from sheet stock.",
  "not_for": "Hems, edge flanges or cutouts (see docs/SHEET_METAL.md to add them).",
  "checks": [
    "valid folded and flat solids",
    "flat blank fits the stock sheet",
    "mass in the chosen material"
  ],
  "inputs": [
    {
      "id": "width",
      "kind": "length",
      "default": 40,
      "minimum": 5,
      "maximum": 1000,
      "description": "Channel width along y."
    },
    {
      "id": "base",
      "kind": "length",
      "default": 60,
      "minimum": 5,
      "maximum": 1000,
      "description": "Base flange length (between the bends, on the midplane)."
    },
    {
      "id": "side_height",
      "kind": "length",
      "default": 25,
      "minimum": 3,
      "maximum": 500,
      "description": "Each side flange's length (on the midplane)."
    },
    {
      "id": "thickness",
      "kind": "length",
      "default": 1.5,
      "minimum": 0.3,
      "maximum": 10,
      "description": "Sheet thickness."
    },
    {
      "id": "bend_radius",
      "kind": "length",
      "default": 2,
      "minimum": 0.1,
      "maximum": 50,
      "description": "Inside bend radius."
    },
    {
      "id": "neutral_factor",
      "kind": "number",
      "default": 0.44,
      "minimum": 0.3,
      "maximum": 0.5,
      "description": "K factor for the flat pattern."
    },
    {
      "id": "material",
      "kind": "choice",
      "default": "aluminum_6061_t6",
      "choices": [
        "aluminum_6061_t6",
        "stainless_steel_304",
        "brass_c360"
      ],
      "description": "Sheet material (docs/MATERIALS.md)."
    },
    {
      "id": "max_mass_kg",
      "kind": "number",
      "default": 0.5,
      "minimum": 0.001,
      "maximum": 100,
      "description": "Largest acceptable mass (kg)."
    },
    {
      "id": "stock_x",
      "kind": "length",
      "default": 300,
      "minimum": 10,
      "maximum": 5000,
      "description": "Sheet stock length the flat blank must fit."
    },
    {
      "id": "stock_y",
      "kind": "length",
      "default": 300,
      "minimum": 10,
      "maximum": 5000,
      "description": "Sheet stock width the flat blank must fit."
    }
  ],
