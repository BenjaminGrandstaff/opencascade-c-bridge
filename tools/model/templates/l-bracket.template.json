              }
            },
            "minimum": {
              "value": 20,
              "dimension": "length",
              "unit": "millimeter"
            },
            "maximum": {
              "value": 400,
              "dimension": "length",
              "unit": "millimeter"
            }
          },
          {
            "id": "thickness",
            "parameter_type": {
              "scalar": "length"
            },
            "default": {
              "scalar": {
                "$input": "thickness",
                "as": "quantity"
              }
            },
            "minimum": {
              "value": 1,
              "dimension": "length",
              "unit": "millimeter"
            },
            "maximum": {
              "value": 30,
              "dimension": "length",
              "unit": "millimeter"
            }
          },
          {
