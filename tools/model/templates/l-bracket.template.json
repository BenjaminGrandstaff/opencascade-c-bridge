{
  "schema": "occb-model-template-v1",
  "id": "l-bracket",
  "version": 1,
  "title": "L-bracket with clearance holes",
  "summary": "A right-angle bracket: base and upright legs of one thickness, an ISO 273 clearance hole through each leg, sized for a metric bolt.",
  "use_when": "Mounting one part square to another with bolts; a load pushes on the top of the upright.",
  "not_for": "Gussets, slotted holes, or loads along the bracket's width.",
  "checks": [
    "valid solid",
    "exact minimum wall",
    "mass in the chosen material",
    "bending at the upright's root (moment = load_n x upright_height)"
  ],
  "inputs": [
    {
      "id": "width",
      "kind": "length",
      "default": 30,
      "minimum": 10,
      "maximum": 200,
      "description": "Bracket width along y."
    },
    {
      "id": "base_length",
      "kind": "length",
      "default": 60,
      "minimum": 20,
      "maximum": 400,
      "description": "Base leg length along x, including the upright's thickness."
    },
    {
      "id": "upright_height",
      "kind": "length",
      "default": 50,
      "minimum": 20,
      "maximum": 400,
      "description": "Upright leg height along z, including the base's thickness."
    },
    {
      "id": "thickness",
      "kind": "length",
      "default": 5,
      "minimum": 1,
      "maximum": 30,
      "description": "Thickness of both legs."
    },
    {
      "id": "bolt",
      "kind": "length",
      "default": 6,
      "minimum": 3,
      "maximum": 12,
      "description": "Metric bolt size for the two ISO 273 medium clearance holes.",
      "allowed": [
        3,
        4,
        5,
        6,
        8,
        10,
        12
      ]
    },
    {
      "id": "material",
      "kind": "choice",
      "default": "aluminum_6061_t6",
      "choices": [
        "aluminum_6061_t6",
        "stainless_steel_304",
        "titanium_cnc",
        "brass_c360",
        "abs_cnc",
        "polycarbonate_cnc",
        "pom_acetal_copolymer",
        "nylon_6_6",
        "peek",
        "pei_ultem_1000",
        "pla_printed",
        "petg_printed"
      ],
      "description": "Catalog material (docs/MATERIALS.md)."
    },
    {
      "id": "load_n",
      "kind": "number",
      "default": 200,
      "minimum": 0,
      "maximum": 100000,
      "description": "Horizontal load (N) at the top of the upright, bending it about y."
    },
    {
      "id": "safety_factor",
      "kind": "number",
      "default": 2,
      "minimum": 1,
      "maximum": 10,
      "description": "Required safety factor against the material's yield at the upright's root."
    },
    {
      "id": "max_mass_kg",
      "kind": "number",
      "default": 0.5,
      "minimum": 0.001,
      "maximum": 100,
      "description": "Largest acceptable mass (kg)."
    },
    {
      "id": "min_wall",
      "kind": "length",
      "default": 2,
      "minimum": 0.5,
      "maximum": 20,
      "description": "Thinnest acceptable wall, including the material around the holes."
    }
  ],
  "request": {
    "schema": "occb-model-request-v1",
    "model": {
      "schema_version": 181,
      "family": {
        "id": "l-bracket",
        "version": 1,
        "parameters": [
          {
            "id": "width",
