            },
            "maximum": {
              "value": 12,
              "dimension": "length",
              "unit": "millimeter"
            }
          }
        ],
        "derived_parameters": [],
        "derived_vector_parameters": [],
        "constraints": [],
        "requirements": [
          {
            "id": "valid",
            "version": 1,
            "kind": "validation",
            "priority": "required",
            "statement": "The bracket is one valid solid.",
            "rule": {
              "shape_valid": {
                "output": "body"
              }
            },
            "provenance": "template; limits come from the template inputs",
            "traces": [
              {
                "feature": "body"
              }
            ]
          },
          {
            "id": "wall",
            "version": 1,
            "kind": "manufacturing",
            "priority": "required",
            "statement": "No wall is thinner than min_wall.",
            "rule": {
              "exact_minimum_wall": {
                "output": "body",
                "minimum": {
                  "$input": "min_wall",
                  "as": "quantity"
                }
              }
            },
            "provenance": "template; limits come from the template inputs",
            "traces": [
              {
                "feature": "body"
              }
            ]
          },
          {
            "id": "mass",
            "version": 1,
            "kind": "functional",
            "priority": "required",
            "statement": "The bracket weighs at most max_mass_kg in the chosen material.",
            "rule": {
              "mass_range": {
                "output": "body",
                "material": {
                  "$input": "material"
                },
                "minimum_kilograms": 0,
                "maximum_kilograms": {
                  "$input": "max_mass_kg"
                }
              }
            },
            "provenance": "template; limits come from the template inputs",
            "traces": [
              {
                "feature": "body"
              }
            ]
          },
          {
            "id": "root-bending",
            "version": 1,
            "kind": "functional",
            "priority": "required",
            "statement": "The upright's root carries load_n at its top with safety_factor against yield.",
            "rule": {
              "bending_stress": {
                "output": "body",
                "material": {
                  "$input": "material"
                },
                "section_origin": {
                  "x": {
                    "$input": "thickness",
                    "as": "quantity",
                    "scale": 0.5
                  },
                  "y": {
                    "$input": "width",
                    "as": "quantity",
                    "scale": 0.5
                  },
                  "z": {
                    "$sum": [
                      {
                        "$input": "thickness"
                      },
                      0.5
                    ],
                    "kind": "length",
                    "as": "quantity"
                  }
                },
                "beam_axis": {
                  "x": {
                    "value": 0,
                    "dimension": "scalar",
                    "unit": null
                  },
                  "y": {
                    "value": 0,
                    "dimension": "scalar",
                    "unit": null
                  },
                  "z": {
                    "value": 1,
                    "dimension": "scalar",
                    "unit": null
                  }
                },
                "bending_axis": {
                  "x": {
                    "value": 0,
                    "dimension": "scalar",
                    "unit": null
                  },
                  "y": {
                    "value": 1,
                    "dimension": "scalar",
                    "unit": null
                  },
                  "z": {
                    "value": 0,
                    "dimension": "scalar",
                    "unit": null
                  }
                },
                "moment_newton_millimeters": {
                  "$product": [
                    {
                      "$input": "load_n"
                    },
                    {
                      "$input": "upright_height"
                    }
                  ]
                },
                "minimum_safety_factor": {
                  "$input": "safety_factor"
                }
              }
            },
            "provenance": "template; limits come from the template inputs",
            "traces": [
              {
                "feature": "body"
              }
            ]
          }
        ],
        "datums": [],
        "features": [
          {
            "id": "base",
            "operation": {
              "box": {
                "origin": {
                  "components": {
                    "x": {
                      "literal": {
                        "value": 0,
